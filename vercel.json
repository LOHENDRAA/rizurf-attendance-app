{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && mv dist/index.html app.shell.html",
  "outputDirectory": "dist",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "app.shell.html"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "crons": [
    { "path": "/api/cron-reminders", "schedule": "0 1 * * *" },
    { "path": "/api/cron-reminders", "schedule": "0 10 * * *" }
  ]
}
