# All clock-in/out timestamps and the schedule below are evaluated in this
# timezone, regardless of what timezone the server itself is set to.
APP_TIMEZONE=Asia/Kuala_Lumpur

DB_HOST=127.0.0.1
DB_NAME=qr_system
DB_USER=root
DB_PASS=

EMPLOYEE_ID=1
EMPLOYEE_NAME=Your Name

OFFICE_QR=your-office-qr-payload
OFFICE_LATITUDE=0.0
OFFICE_LONGITUDE=0.0
OFFICE_RADIUS_METERS=100

# Web Push (VAPID) -- generate a keypair with, e.g., `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Used only by api/send-reminders.php (run this on a schedule)
REMINDER_CLOCK_IN_DEADLINE=09:10
REMINDER_SHIFT_END=18:00
REMINDER_LEAD_MINUTES=15
LUNCH_BREAK_START=13:00
LUNCH_BREAK_END=14:00
