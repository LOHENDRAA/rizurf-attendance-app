# ============================================================================
# Rizurf Attendance App - environment template
#
#   cp .env.example .env      then fill in the real values
#
# THIS FILE IS COMMITTED - placeholders only. Real secrets go in .env
# (gitignored). Per SS-20 the app reads every value from the environment and
# fails loudly at startup if one is missing.
# ============================================================================

# --- Database (MySQL 8) ----------------------------------------------------------
DB_HOST=db.example.com
DB_PORT=3306
DB_NAME=rizurf_attendance
DB_USER=rizurf_attendance
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
# Session time zone so clock_in / clock_out read back as Asia/Kuala_Lumpur.
DB_TIME_ZONE=+08:00

# --- Rizurf gateway (authentication - MICROAPP_AUTH.md) ---------------------
GATEWAY_URL=https://web-omega-two-47.vercel.app
# This app's own public address, exactly as the gateway is registered to know
# it. Used for redirect_uri and to check the token's iss / aud. Never inferred
# from an incoming request.
PUBLIC_URL=http://127.0.0.1:3400
# This service's id - the `service` field in GET /health and the token `aud`.
SERVICE_ID=attendance-api
# Kept equal to /health's version and openapi info.version (SS-2).
APP_VERSION=1.0.0
# Signs the app's own session cookie (HMAC). Generate: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX
SESSION_TTL_SECONDS=900

# Local dev only: skip auth on /api/* so the SPA works without a gateway
# sign-in. MUST be false/unset on the deployment registered with the gateway -
# conformance fails if /api/* returns 200 to an anonymous caller.
DEV_ALLOW_NO_AUTH=false
DEV_INTERN_REF=INT-0007
# DEV_GATEWAY_SUB=
# Also local dev only: use a small fixed roster instead of calling the real
# Intern Database service, so the app runs with no live infrastructure at
# all beyond a MySQL database. Only takes effect alongside DEV_ALLOW_NO_AUTH.
DEV_MOCK_INTERNS=false
# Local dev only: lets the admin panel (GET/POST /api/admin/*) be tested
# without a real gateway session carrying role=admin. Only takes effect
# alongside DEV_ALLOW_NO_AUTH; unset or anything but "admin" means no
# admin access, same as a real signed-in non-admin.
DEV_ROLE=

# --- Intern Database service ----------------------------------------------------
# The app resolves intern records from this service's API (client_credentials
# grant against the gateway, audience = INTERN_DB_AUDIENCE, scope intern:read).
INTERN_DB_URL=https://intern-database.vercel.app
INTERN_DB_AUDIENCE=intern-database
INTERN_DB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
INTERN_DB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# --- Department Management service (department-api) -----------------------------
# Resolves an intern's department_id (e.g. "DEP-0001") to a display name.
# Reuses the same INTERN_DB_CLIENT_ID/SECRET above against a different
# audience -- best-effort only, falls back to the raw code if unreachable.
DEPARTMENT_API_URL=https://department-api.vercel.app
DEPARTMENT_API_AUDIENCE=department-api

# --- Office / attendance rules -------------------------------------------------
OFFICE_QR=Rizurf_Attandance
OFFICE_LATITUDE=3.0862205788137413
OFFICE_LONGITUDE=101.69002156884324
OFFICE_RADIUS_METERS=100
OFFICE_ADDRESS=First Floor, 28-1, Jln 1/116B, Sri Desa Entrepreneur Park

# --- Local dev ----------------------------------------------------------------
PORT=3400
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- Clock-in/out push reminders -------------------------------------------------
# The public half is also hardcoded in src/App.jsx (VAPID_PUBLIC_KEY) -- if
# these are ever regenerated, update both together or existing subscriptions
# stop working. Generate a pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@rizurf.com
# Clock-in reminder fires once, this many minutes after the on-time window
# closes, for anyone who hasn't clocked in yet. Clock-out reminder fires once
# within REMINDER_LEAD_MINUTES of shift end, for anyone still clocked in.
REMINDER_CLOCK_IN_DEADLINE=09:10
REMINDER_SHIFT_END=18:00
REMINDER_LEAD_MINUTES=15
# Shared secret for GET /api/cron-reminders. Set an env var of this exact
# name in the Vercel project and Vercel Cron sends it automatically as
# "Authorization: Bearer <this>". Generate: openssl rand -hex 24
CRON_SECRET=REPLACE_WITH_RANDOM_HEX
