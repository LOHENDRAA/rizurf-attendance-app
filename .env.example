# ============================================================================
# Rizurf Attendance App - environment template
#
#   cp .env.example .env      then fill in the real values
#
# THIS FILE IS COMMITTED - it must only ever hold placeholders. Real secrets
# go in .env (gitignored). Per SS-20 the app reads every value below from the
# environment and fails loudly at startup if one is missing.
# ============================================================================

# --- Database (Supabase now, self-hosted Postgres on the VPS later) ----------
# Runtime connection: the TRANSACTION pooler string (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:REPLACE_WITH_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# Schema loads / migrations only: the DIRECT or SESSION pooler string (port 5432).
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:REPLACE_WITH_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase REST + Storage (intern photos, MC slips).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY   # server-side only; bypasses RLS
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY                   # safe to expose; reads nothing without policies

# --- Rizurf gateway (authentication - MICROAPP_AUTH.md) ---------------------
GATEWAY_URL=https://web-omega-two-47.vercel.app
# This app's own public address, exactly as the gateway is registered to know
# it. Used to build redirect_uri and to check the token's `iss`/`aud`. Never
# inferred from an incoming request.
PUBLIC_URL=http://127.0.0.1:3400
# This service's id - the `service` field in GET /health and the `aud` the
# gateway mints identity tokens for.
SERVICE_ID=attendance-api
# Kept equal to /health's version and openapi info.version (SS-2).
APP_VERSION=1.0.0

# Secret for signing this app's own session cookie (HMAC). Generate a random
# 32+ byte value, e.g.  openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_HEX
SESSION_TTL_SECONDS=900

# Local dev only: skip auth on /api/* so the SPA works before the gateway
# sign-in is built. MUST be false/unset on the deployment registered with the
# gateway - conformance fails if /api/* returns 200 to an anonymous caller.
DEV_ALLOW_NO_AUTH=false
# With DEV_ALLOW_NO_AUTH on, the API acts as this intern.
# Set DEV_GATEWAY_SUB instead to resolve through app_identities.
DEV_INTERN_REF=INT-0007
# DEV_GATEWAY_SUB=

# --- Intern Database service ----------------------------------------------------
# The attendance app resolves intern records from this service's API
# (client_credentials grant against the gateway, audience = INTERN_DB_AUDIENCE,
# scope intern:read). The client id/secret are issued in the gateway's API
# clients admin page.
INTERN_DB_URL=https://intern-database.vercel.app
INTERN_DB_AUDIENCE=intern-database
INTERN_DB_CLIENT_ID=REPLACE_WITH_CLIENT_ID
INTERN_DB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# --- Office / attendance rules (today hardcoded in api/config.php + src/App.jsx) -
OFFICE_QR=Rizurf_Attandance
OFFICE_LATITUDE=3.0862205788137413
OFFICE_LONGITUDE=101.69002156884324
OFFICE_RADIUS_METERS=100
OFFICE_ADDRESS=First Floor, 28-1, Jln 1/116B, Sri Desa Entrepreneur Park

# --- Local dev ----------------------------------------------------------------
PORT=3400
TZ=Asia/Kuala_Lumpur
